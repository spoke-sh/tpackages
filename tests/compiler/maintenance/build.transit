CREATE TARGET default AS BEGIN
  CREATE PUBLIC TABLE expiry (id TEXT PRIMARY KEY, expires_at BIGINT);
  CREATE PUBLIC DATAFLOW cleanup FROM TIMER EVERY SECONDS(60) AS tick AS BEGIN ATOMIC
    LET batch = SELECT MANY id FROM expiry WHERE expires_at <= UNIX_SECONDS(NOW()) ORDER BY expires_at, id LIMIT 64;
    FOR item IN batch DO DELETE FROM expiry WHERE id = item.id; END FOR;
  END;
END;
