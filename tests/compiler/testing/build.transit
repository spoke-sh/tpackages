CREATE MODULE Fixture() AS BEGIN
  CREATE PUBLIC TABLE rows (id BIGINT PRIMARY KEY);
END;
CREATE PUBLIC TEST TARGET tests AS BEGIN
  TEST 'deterministic clock' USING MODULES (Fixture()) AS BEGIN
    SET TEST CLOCK '2026-01-01T00:00:00Z';
    ASSERT NOW() = TIMESTAMP '2026-01-01T00:00:00Z';
  END;
END;
