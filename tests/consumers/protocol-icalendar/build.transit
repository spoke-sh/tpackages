DEPENDENCY library FROM WORKSPACE 'icalendar';
IMPORT library FROM PACKAGE library FILE 'build.transit';

EXPORT MODULE Application() AS BEGIN
  LET codec = USE library.Codec();
  EXPORT MODULE codec AS codec;
END;
LET application = USE Application();
EXPORT TARGET default AS SQL OF application;

CREATE PUBLIC TEST TARGET tests AS BEGIN
  TEST 'only the selected public package closure is emitted' AS BEGIN
    ASSERT DEPENDENCIES default EQUAL SET('icalendar');
    ASSERT NO OUTPUT FROM PACKAGES EXCEPT SET('icalendar');
    ASSERT NO RESOURCES OF KINDS (TABLE, DOCUMENT, KV, QUEUE, STREAM, DATAFLOW, SOURCE, SINK, PUBLICATION) IN default;
  END;
END;
