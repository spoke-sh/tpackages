DEPENDENCY package_0 FROM WORKSPACE 'oidc';
IMPORT package_0 FROM PACKAGE package_0 FILE 'build.transit';

EXPORT MODULE Application0() AS BEGIN
  LET api = USE package_0.RelyingParty(SCHEMA_BINDING('consumer_oidc_github_0_oidc'), ROW(
    oauth => ROW(client_id => 'example-client', client_secret => 'example.oauth.client_secret',
      redirect_uri => 'https://app.example.test/callback/oidc', scopes => SET('openid', 'profile'),
      challenge_seconds => 300, credential_seconds => 3600,
      allowed_hosts => SET('accounts.google.com', 'oauth2.googleapis.com', 'www.googleapis.com'),
      authorization_parameters => MAP()),
    issuer => 'https://accounts.google.com', authorization_endpoint => 'https://accounts.google.com/o/oauth2/v2/auth',
    token_endpoint => 'https://oauth2.googleapis.com/token', jwks_uri => 'https://www.googleapis.com/oauth2/v3/certs',
    client_auth => 'client_secret_post', metadata_seconds => 600, clock_skew_seconds => 30,
    max_token_age_seconds => 3600, max_auth_age_seconds => NONE
  ));
  EXPORT MODULE api AS api;
END;

DEPENDENCY package_1 FROM WORKSPACE 'oauth-github';
IMPORT package_1 FROM PACKAGE package_1 FILE 'build.transit';

EXPORT MODULE Application1() AS BEGIN
  LET api = USE package_1.Client(SCHEMA_BINDING('consumer_oidc_github_1_oauth_github'), ROW(
    client_id => 'example-client', client_secret => 'example.oauth.client_secret',
    redirect_uri => 'https://app.example.test/callback/github',
    scopes => SET('read:user'), challenge_seconds => 300,
    credential_seconds => 86400, allowed_hosts => SET('github.com'),
    authorization_parameters => MAP()
  ));
  EXPORT MODULE api AS api;
END;


EXPORT MODULE Consumer() AS BEGIN
  LET instance_0 = USE Application0();
  BIND SCHEMA result_0 TO SCHEMA_BINDING('consumer_oidc_github_result_0');
  CREATE PRIVATE TABLE result_0.events (id TEXT PRIMARY KEY, owner OWNER);
  CREATE DATAFLOW result_0.consume FROM STREAM instance_0.api.completions AS event
    WITH (consumer = 'application.results', required = TRUE, checkpoint = 'terminal_atomic') AS BEGIN ATOMIC
    INSERT INTO result_0.events VALUES (CAST(event.event_id AS TEXT), event.owner)
      ON CONFLICT (id) DO ASSERT SAME ROW;
  END;
  CREATE VIEW result_0.visible AS SELECT * FROM result_0.events WHERE owner = CURRENT_OWNER();
  EXPORT VIEW result_0.visible AS observed_0;
  AUTHORIZE MODULE instance_0.api WITH (
    commands = ROLE SETTING('example.command_role'), state = ROLE SETTING('example.state_role'),
    effects = ROLE SETTING('example.effect_role'), reads = ROLE SETTING('example.read_role'),
    maintenance = ROLE SETTING('example.maintenance_role')
  );
  AUTHORIZE DATAFLOW result_0.consume AS ROLE SETTING('example.consumer_role');
  ACTIVATE MODULE instance_0.api;
  ACTIVATE DATAFLOW result_0.consume;
  EXPORT MODULE instance_0 AS instance_0;
  LET instance_1 = USE Application1();
  BIND SCHEMA result_1 TO SCHEMA_BINDING('consumer_oidc_github_result_1');
  CREATE PRIVATE TABLE result_1.events (id TEXT PRIMARY KEY, owner OWNER);
  CREATE DATAFLOW result_1.consume FROM STREAM instance_1.api.completions AS event
    WITH (consumer = 'application.results', required = TRUE, checkpoint = 'terminal_atomic') AS BEGIN ATOMIC
    INSERT INTO result_1.events VALUES (CAST(event.event_id AS TEXT), event.owner)
      ON CONFLICT (id) DO ASSERT SAME ROW;
  END;
  CREATE VIEW result_1.visible AS SELECT * FROM result_1.events WHERE owner = CURRENT_OWNER();
  EXPORT VIEW result_1.visible AS observed_1;
  AUTHORIZE MODULE instance_1.api WITH (
    commands = ROLE SETTING('example.command_role'), state = ROLE SETTING('example.state_role'),
    effects = ROLE SETTING('example.effect_role'), reads = ROLE SETTING('example.read_role'),
    maintenance = ROLE SETTING('example.maintenance_role')
  );
  AUTHORIZE DATAFLOW result_1.consume AS ROLE SETTING('example.consumer_role');
  ACTIVATE MODULE instance_1.api;
  ACTIVATE DATAFLOW result_1.consume;
  EXPORT MODULE instance_1 AS instance_1;
END;
LET consumer = USE Consumer();
EXPORT TARGET default AS SQL OF consumer;
CREATE PUBLIC TEST TARGET tests AS BEGIN
  TEST 'selected package closure contains no unrelated packages' AS BEGIN
    ASSERT DEPENDENCIES default EQUAL SET('oauth', 'oauth-github', 'oidc');
    ASSERT NO OUTPUT FROM PACKAGES EXCEPT SET('oauth', 'oauth-github', 'oidc');
  END;
END;
