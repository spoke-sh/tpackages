CREATE DATAFLOW oauth.refresh FROM COMMAND (id types.CredentialId, generation BIGINT) AS request
  WITH (idempotency = 'original_owner_request') AS BEGIN ATOMIC
  REQUIRE metadata.refresh ELSE 'RefreshUnsupported';
  LET policy = SELECT ONE * FROM oauth.policy WHERE id = 'client';
  REQUIRE oauth.require_policy(policy._revision);
  LET credential = SELECT ONE * FROM oauth.credentials WHERE id = request.id AND owner = CURRENT_OWNER();
  REQUIRE credential.status = 'active' AND credential.generation = request.generation ELSE 'StaleCredential';
  REQUIRE IS_PRESENT(credential.refresh) AND credential.refresh_expires_at > NOW() ELSE 'RefreshUnavailable';
  LET operation = types.OperationId(OPERATION_ID(CURRENT_REQUEST_ID(), 'refresh'));
  UPDATE oauth.credentials SET status = 'refreshing' WHERE id = request.id;
  INSERT INTO oauth.operations VALUES (operation, CURRENT_OWNER(), NONE, types.Outcome.Pending(operation));
  ENQUEUE INTO oauth.refresh_jobs VALUES (operation, CURRENT_OWNER(), request.id, request.generation,
    policy._revision, SECRET($config.client_secret).revision, NOW() + SECONDS(30));
  RETURN operation;
END;

CREATE DATAFLOW oauth.revoke FROM COMMAND (id types.CredentialId, generation BIGINT) AS request
  WITH (idempotency = 'original_owner_request') AS BEGIN ATOMIC
  REQUIRE IS_PRESENT(metadata.revocation_endpoint) ELSE 'RevocationUnsupported';
  LET policy = SELECT ONE * FROM oauth.policy WHERE id = 'client';
  REQUIRE oauth.require_policy(policy._revision);
  LET credential = SELECT ONE * FROM oauth.credentials WHERE id = request.id AND owner = CURRENT_OWNER();
  REQUIRE credential.status = 'active' AND credential.generation = request.generation ELSE 'StaleCredential';
  LET operation = types.OperationId(OPERATION_ID(CURRENT_REQUEST_ID(), 'revoke'));
  UPDATE oauth.credentials SET status = 'revoking' WHERE id = request.id;
  INSERT INTO oauth.operations VALUES (operation, CURRENT_OWNER(), NONE, types.Outcome.Pending(operation));
  ENQUEUE INTO oauth.revoke_jobs VALUES (operation, CURRENT_OWNER(), request.id, request.generation,
    policy._revision, SECRET($config.client_secret).revision, NOW() + SECONDS(30));
  RETURN operation;
END;
