IMPORT core FROM './relying-party.transit';
CREATE PUBLIC MODULE Publication(binding SCHEMA_BINDING, api MODULE OF core.RelyingParty, path TEXT) AS BEGIN
  BIND SCHEMA reads TO $binding;
  CREATE PUBLICATION reads.results AS SELECT * FROM $api.credential_metadata
    WITH (snapshot_path = $path, authentication = 'native', disclosure = 'current_authority',
      response_cache = 'no-store', page_size = 64);
  EXPORT PUBLICATION reads.results AS results;
END;
