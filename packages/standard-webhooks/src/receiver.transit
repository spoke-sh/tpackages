IMPORT signature FROM './signatures.transit';
CREATE PUBLIC MODULE Receiver(binding SCHEMA_BINDING, endpoint TEXT, keys LIST<ROW(scheme TEXT, reference TEXT)>) AS BEGIN
  BIND SCHEMA receiver TO $binding;
  LET signatures = USE signature.Signatures();
  CREATE PRIVATE DOCUMENT receiver.policy (id TEXT PRIMARY KEY, enabled BOOLEAN) WITH (profile = 'versioned');
  INSERT INTO receiver.policy VALUES ('endpoint', TRUE) ON CONFLICT DO NOTHING;
  CREATE PRIVATE KV receiver.claims (ROW(owner OWNER, digest BYTES, payload PROTECTED_REF));
  CREATE PRIVATE STREAM receiver.accepted (event_id TEXT, owner OWNER, observed_at TIMESTAMP)
    WITH (retention = 'unlimited', partition_by = 'owner', disclosure = 'current_owner');
  CREATE DATAFLOW receiver.accept FROM COMMAND (headers HTTP_FIELDS, body SECRET<BYTES>) AS request
    WITH (idempotency = 'original_owner_request') AS BEGIN ATOMIC
    REQUIRE (SELECT ONE enabled FROM receiver.policy WHERE id = 'endpoint').enabled ELSE 'EndpointDisabled';
    LET trust = MAP_LIST($keys, item => ROW(scheme => item.scheme, key => SECRET(item.reference)));
    LET id = signatures.verify(request.headers, request.body, $endpoint, trust, NOW());
    REQUIRE ALL(trust, item => SECRET_CURRENT(item.key)) ELSE 'KeyChanged';
    LET key = ROW(owner => CURRENT_OWNER(), message => id);
    LET previous = GET FROM receiver.claims KEY key;
    LET digest = COMMITMENT(request.body);
    IF IS_PRESENT(previous) THEN
      REQUIRE REQUIRE_SOME(previous).value.digest = digest ELSE 'ConflictingMessage';
      RETURN id;
    END IF;
    PUT INTO receiver.claims KEY key VALUE ROW(owner => CURRENT_OWNER(), digest => digest,
      payload => PROTECT(request.body, 'webhook.body', INFINITY)) IF ABSENT;
    PRODUCE INTO receiver.accepted VALUES (id, CURRENT_OWNER(), NOW());
    RETURN id;
  END;
  CREATE DATAFLOW receiver.read_payload FROM COMMAND (id TEXT) AS request AS BEGIN ATOMIC
    LET item = REQUIRE_SOME(GET FROM receiver.claims KEY ROW(owner => CURRENT_OWNER(), message => request.id));
    REQUIRE (SELECT ONE enabled FROM receiver.policy WHERE id = 'endpoint').enabled ELSE 'EndpointDisabled';
    RETURN UNPROTECT(item.value.payload, 'webhook.body');
  END;
  CREATE DATAFLOW receiver.set_enabled FROM COMMAND (enabled BOOLEAN, revision REVISION) AS request AS BEGIN ATOMIC
    UPDATE receiver.policy SET enabled = request.enabled WHERE id = 'endpoint' IF REVISION = request.revision;
  END;
  CREATE PUBLIC VIEW policy AS SELECT enabled, DOCUMENT_REVISION(receiver.policy, 'endpoint') AS revision FROM receiver.policy WHERE id = 'endpoint';
  EXPORT DATAFLOW receiver.accept AS accept;
  EXPORT DATAFLOW receiver.read_payload AS read_payload;
  EXPORT DATAFLOW receiver.set_enabled AS set_enabled;
  EXPORT STREAM receiver.accepted AS accepted;
END;
