IMPORT oauth FROM PACKAGE oauth FILE 'build.transit';
IMPORT example FROM '../examples/build.transit';
LET application = USE example.Application();
LET browser = USE example.HttpApplication();
EXPORT TARGET core AS TESTS OF application USING SUITES (
  oauth.ClientContract, './provider.test.transit'
);
EXPORT TARGET http AS TESTS OF browser USING SUITES (oauth.HttpContract);
EXPORT TEST TARGET tests AS GROUP (core, http);
