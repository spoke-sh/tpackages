CREATE PUBLIC FUNCTION claims(nonce TEXT) RETURNS JSON AS BEGIN
  RETURN JSON_OBJECT('iss', 'https://accounts.google.com', 'sub', 'subject-1',
    'aud', 'example-client', 'iat', 1767225600, 'exp', 1767229200, 'nonce', $nonce);
END;

CREATE PUBLIC FUNCTION keys() RETURNS JSON TEST ONLY AS BEGIN
  RETURN JSON_OBJECT('keys', JSON_ARRAY_OF(JSON_SET(JWK_ENCODE(TEST_PUBLIC_KEY('issuer')),
    'kid', JSON_FROM_TEXT('key-1'))));
END;

CREATE PUBLIC FUNCTION token(claims JSON) RETURNS SECRET<TEXT> TEST ONLY AS BEGIN
  LET header = BASE64URL(UTF8('{"alg":"RS256","kid":"key-1"}'));
  LET payload = BASE64URL(UTF8(JSON_SERIALIZE($claims)));
  LET input = header || '.' || payload;
  RETURN TEST_PROTECT(input || '.' || BASE64URL(CRYPTO_SIGN('RS256', TEST_PRIVATE_KEY('issuer'), UTF8(input))));
END;

CREATE PUBLIC FUNCTION discovery() RETURNS JSON AS BEGIN
  RETURN JSON '{"issuer":"https://accounts.google.com","authorization_endpoint":"https://accounts.google.com/o/oauth2/v2/auth","token_endpoint":"https://oauth2.googleapis.com/token","jwks_uri":"https://www.googleapis.com/oauth2/v3/certs","response_types_supported":["code"],"id_token_signing_alg_values_supported":["RS256"],"code_challenge_methods_supported":["S256"],"token_endpoint_auth_methods_supported":["client_secret_post"]}';
END;
